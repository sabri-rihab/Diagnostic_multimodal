FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y libgl1 && rm -rf /var/lib/apt/lists/*

COPY src/api/requirements.classification.txt .
RUN pip install --no-cache-dir -r requirements.classification.txt

COPY src/api/classification_api.py .

CMD ["uvicorn", "classification_api:app", "--host", "0.0.0.0", "--port", "8001"]
